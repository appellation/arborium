{
  "name": "@arborium/<%= grammar_id %>",
  "version": "<%= version %>",
  "description": "Tree-sitter grammar for <%= grammar_name %>, used by arborium syntax highlighting",
  "exports": {
    "./language.wasm": "./language.wasm",
    "./highlights.scm": "./highlights.scm",
    "./injections.scm": "./injections.scm",
    "./locals.scm": "./locals.scm"
  },
  "files": ["language.wasm", "highlights.scm", "injections.scm", "locals.scm"],
  "keywords": [
    "arborium",
    "syntax-highlighting",
    "tree-sitter",
    "<%= grammar_id %>",
    "<%= grammar_name %>",
    "wasm"
  ],
  "author": "Amos Wenger <amos@bearcove.eu>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bearcove/arborium"
  },
  "homepage": "https://github.com/bearcove/arborium",
  "bugs": {
    "url": "https://github.com/bearcove/arborium/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/fasterthanlime"
  },
  "publishConfig": {
    "access": "public"
  }
}
